# App (Supabase REST, used by Next.js and the preflight scripts)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred by the preflight scripts; required for any script that writes via REST.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by:
#   scripts/generate-content-migration.py --apply
#   scripts/bootstrap-local-db.py
# Local:  postgresql://postgres:<password>@localhost:5432/launchpad_local
# Hosted: the Supabase project's direct connection string
DATABASE_URL=

# Cache revalidation
LAUNCHPAD_REVALIDATE_SECRET=
# Base URL that --revalidate posts to, e.g. https://launchpad.example.com
LAUNCHPAD_SITE_URL=

# Content sheet sync (scripts/sync-content-sheet.py)
# Path to the Google service account key JSON. Never commit the key.
LAUNCHPAD_SHEETS_CREDENTIALS=
# Spreadsheet id from the "LaunchPad Live Content" sheet URL.
LAUNCHPAD_CONTENT_SHEET_ID=

NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ANALYTICS_DISABLED=
